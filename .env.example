# UniPress DE — environment (copy to .env and fill in)
# .env is gitignored; never commit real secrets.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
OTEL_SERVICE_NAME=unipress

# --- Postgres ---
POSTGRES_USER=unipress
POSTGRES_PASSWORD=unipress
POSTGRES_DB=unipress

# --- Observability (used by the `observability` profile) ---
# Point the app at the OTel collector. Leave blank to disable OTLP export.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
GRAFANA_ADMIN_PASSWORD=admin

# --- LLM + TrustLayer ---
# The LLM path is doubly gated: a key AND the matching flag. With the flags off
# (or no key) the app runs its deterministic fallback and spends nothing, which
# is what CI and local dev use. Turn generation on first, then extraction.
OPENAI_API_KEY=
LLM_GENERATION=false
LLM_EXTRACTION=false
LLM_JUDGE=false
LLM_GENERATION_MODEL=gpt-4o
LLM_EXTRACT_MODEL=gpt-4o-mini
LLM_JUDGE_MODEL=gpt-4o-mini
# TrustLayer entailment: "lexical" (deterministic proxy) | "nli" (mDeBERTa XNLI,
# downloads ~1 GB into the hf-cache volume on first use).
NLI_BACKEND=lexical

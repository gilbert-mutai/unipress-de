# UniPress DE — environment (copy to .env and fill in)
# .env is gitignored; never commit real secrets.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
OTEL_SERVICE_NAME=unipress

# --- Postgres ---
POSTGRES_USER=unipress
POSTGRES_PASSWORD=unipress
POSTGRES_DB=unipress

# --- Observability (used by the `observability` profile) ---
# Point the app at the OTel collector. Leave blank to disable OTLP export.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
GRAFANA_ADMIN_PASSWORD=admin

# --- LLM (not used until the generation phase; placeholder) ---
OPENAI_API_KEY=
